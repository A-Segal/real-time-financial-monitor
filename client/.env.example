# Backend API base URL (optional).
#
# When set, the frontend connects directly to this backend for both HTTP API
# calls and the SignalR WebSocket connection.  The Vite dev-server proxy is
# bypassed.
#
# Examples (one per frontend instance):
#   VITE_API_URL=http://127.0.0.1:5120
#   VITE_API_URL=http://127.0.0.1:5121
#   VITE_API_URL=http://127.0.0.1:5122
#
# When omitted the frontend uses relative URLs (/api, /hubs/…), relying on
# the Vite dev-server proxy which defaults to http://127.0.0.1:5120.
#
# VITE_API_URL=
